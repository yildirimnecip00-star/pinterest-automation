# Bu dosya YEREL test icindir. GitHub Actions'ta bunun yerine repo Secrets kullanilir.
# `.env.example` -> `.env` kopyala ve doldur.

# ── Etsy ──────────────────────────────────────────────────────────
# Magaza RSS'inden okunur; API anahtari GEREKMEZ.
# https://anatoliankilimhome.etsy.com -> shop adi:
ETSY_SHOP_NAME=AnatolianKilimHome
# (opsiyonel) kategori anahtar kelimelerini virgulle degistirebilirsin:
# ETSY_PILLOW_KEYWORDS=pillow,cushion,pillowcase,lumbar,sham
# ETSY_MINI_RUG_KEYWORDS=mini rug,small rug,accent rug,mat,doormat,bath rug,kitchen rug
# ETSY_RUG_KEYWORDS=rug,carpet,kilim,oushak,runner

# ── Pinterest ─────────────────────────────────────────────────────
# developers.pinterest.com -> app olustur -> Client ID / Client Secret
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# App ayarlarindaki redirect URI ile birebir ayni olmali
PINTEREST_REDIRECT_URI=https://localhost/callback
# `npm run auth` ciktisi. (CI'da PINTEREST_REFRESH_TOKEN secret'i kullanilir.)
PINTEREST_REFRESH_TOKEN=
# Ikisinden biri: dogrudan pano id VEYA isimle bul/olustur (bos birak -> isimle)
PINTEREST_BOARD_ID=
PINTEREST_BOARD_NAME=Anatolian Kilim Home

# ── Anthropic (Claude) — OPSIYONEL ───────────────────────────────
# Bos birakilirsa baslik/aciklama sablon modunda uretilir.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ── Gorsel tasarimi ──────────────────────────────────────────────
# postcard (varsayilan) | editorial | gallery | split | banner | blur
# Hepsini gormek icin:  npm run variants   -> preview/variants/_compare__*.jpg
IMAGE_VARIANT=postcard

# ── Zamanlama / limitler ─────────────────────────────────────────
MAX_PINS_PER_DAY=30
PER_RUN_LIMIT=30
# CI'da pinler arasi bekleme (sn)
PIN_DELAY_SECONDS=8
# Yerelde pinler arasi rastgele bekleme (dk)
MIN_DELAY_MINUTES=3
MAX_DELAY_MINUTES=8
# Bir ilani kac gun sonra tekrar pinleyebilir (0 = asla)
REPIN_AFTER_DAYS=0
